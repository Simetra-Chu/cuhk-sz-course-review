# 复制本文件为 .env.local，并填入 Supabase 控制台里的真实值（Phase 1 会用到）

NEXT_PUBLIC_SUPABASE_URL=https://你的项目ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的anon公钥

# 仅用于本地导入课程数据的脚本，不要提交到 Git，也不要暴露到前端
SUPABASE_SERVICE_ROLE_KEY=你的service_role私钥

# ---- DEV / 测试库（飞书抽样导入专用，切勿指向 Production）----
# 建议写在 .env.local.development；scripts/feishu-sample-pipeline.ts 只读这些变量
SUPABASE_DEV_URL=https://你的DEV项目ID.supabase.co
SUPABASE_DEV_SERVICE_ROLE_KEY=你的DEV_service_role私钥
# 别名（任选其一即可）：
# NEXT_PUBLIC_SUPABASE_URL_DEV=
# SUPABASE_SERVICE_ROLE_KEY_DEV=
